GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# "true" makes every page require a @jahnelgroup.com sign-in. Default: off,
# reads are public. /api/mcp stays public either way.
REQUIRE_SIGN_IN=false
